+def _env_int(name: str, default: int) -> int:
+    """Read a positive int tunable from the environment, falling back to default."""
+    try:
+        v = int(os.getenv(name, "") or default)
+        return v if v > 0 else default
+    except (TypeError, ValueError):
+        return default
